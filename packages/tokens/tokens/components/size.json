{
  "space": {
    "button": {
      "label-inset": {
        "sm": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.xs}"
        },
        "md": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.sm}"
        },
        "lg": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.md}"
        }
      },
      "padding-x": {
        "sm": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.none}"
        },
        "md": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.xs}"
        },
        "lg": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.md}"
        }
      }
    },
    "input": {
      "padding-x": {
        "$type": "dimension",
        "$extensions": {
          "com.figma": {
            "collection": "components/size"
          }
        },
        "$value": "{space.xs}"
      },
      "gap": {
        "$type": "dimension",
        "$extensions": {
          "com.figma": {
            "collection": "components/size"
          }
        },
        "$value": "{space.xs}"
      },
      "label-inset": {
        "$type": "dimension",
        "$extensions": {
          "com.figma": {
            "collection": "components/size"
          }
        },
        "$value": "{space.xs}"
      }
    },
    "avatar": {
      "ring": {
        "$type": "dimension",
        "$extensions": {
          "com.figma": {
            "collection": "components/size"
          }
        },
        "$value": "{border-width.md}"
      }
    },
    "avatar-group": {
      "overlap": {
        "xl": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.overlap.stack.xl}"
        },
        "lg": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.overlap.stack.lg}"
        },
        "md": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.overlap.stack.md}"
        },
        "sm": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.overlap.stack.sm}"
        },
        "xs": {
          "$type": "dimension",
          "$extensions": {
            "com.figma": {
              "collection": "components/size"
            }
          },
          "$value": "{space.overlap.stack.xs}"
        }
      }
    },
    "list-item": {
      "gap": {
        "$type": "dimension",
        "$description": "Shared by list rows: ListBoxItem (Select options) and MenuItem (action menus).",
        "$extensions": {
          "com.figma": {
            "collection": "components/size"
          }
        },
        "$value": "{space.xs}"
      },
      "padding-x": {
        "$type": "dimension",
        "$description": "Shared by list rows: ListBoxItem (Select options) and MenuItem (action menus).",
        "$extensions": {
          "com.figma": {
            "collection": "components/size"
          }
        },
        "$value": "{space.xs}"
      },
      "padding-y": {
        "$type": "dimension",
        "$description": "Shared by list rows: ListBoxItem (Select options) and MenuItem (action menus).",
        "$extensions": {
          "com.figma": {
            "collection": "components/size"
          }
        },
        "$value": "{space.xs}"
      }
    }
  },
  "radius": {
    "list-item": {
      "$type": "dimension",
      "$description": "Shared by list rows: ListBoxItem (Select options) and MenuItem (action menus).",
      "$extensions": {
        "com.figma": {
          "collection": "components/size"
        }
      },
      "$value": "{radius.md}"
    }
  }
}
