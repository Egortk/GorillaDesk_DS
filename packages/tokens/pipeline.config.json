{
  "fontFallbacks": {
    "Inter": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"]
  },
  "themes": { "light": ":root", "dark": "[data-theme=\"dark\"]",
    "lightScope": "[data-theme=\"light\"]" },
  "hiddenPrefixes": ["primitives", "alpha."],
  "pxKeep": ["border-width", "space.overlap"],
  "tailwindTheme": ["color", "spacing", "radius", "text", "font", "font-weight", "ease", "shadow", "inset-shadow"],
  "tailwindResets": ["color", "font", "font-weight", "radius", "text", "ease", "shadow", "inset-shadow"]
}
